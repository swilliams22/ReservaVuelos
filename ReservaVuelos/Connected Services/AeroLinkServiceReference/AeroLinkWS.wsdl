  <wsdl:portType name="AeroLinkWSSoap">
    <wsdl:operation name="Login">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Valida el email y la contraseña. Si son correctos devuelve los datos básicos del usuario y un token.</wsdl:documentation>
      <wsdl:input message="tns:LoginSoapIn" />
      <wsdl:output message="tns:LoginSoapOut" />
    </wsdl:operation>
    <wsdl:operation name="CalcularPrecioReserva">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Calcula el precio de una reserva: suma, para cada vuelo, el precio unitario por la cantidad de pasajeros.</wsdl:documentation>
      <wsdl:input message="tns:CalcularPrecioReservaSoapIn" />
      <wsdl:output message="tns:CalcularPrecioReservaSoapOut" />
    </wsdl:operation>
    <wsdl:operation name="ObtenerInformeVuelosXml">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Informe de vuelos en XML. Filtro: Todos, Activos o Baja. Requiere el token de un Administrador.</wsdl:documentation>
      <wsdl:input message="tns:ObtenerInformeVuelosXmlSoapIn" />
      <wsdl:output message="tns:ObtenerInformeVuelosXmlSoapOut" />
    </wsdl:operation>
    <wsdl:operation name="ImportarVuelosXml">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Importa vuelos desde un XML (mismo formato que el informe). Requiere el token de un Administrador.</wsdl:documentation>
      <wsdl:input message="tns:ImportarVuelosXmlSoapIn" />
      <wsdl:output message="tns:ImportarVuelosXmlSoapOut" />
    </wsdl:operation>
  </wsdl:portType>
